# Does a homelab beat renting a VPS? Yearly cost in euros.
# Every "a to b" is a 90% confidence interval.

watts = 12 to 30                 # small PC running 24/7
price = 0.12 to 0.25             # euros per kWh
hours = 24 * 365
power = watts / 1000 * hours * price

hardware = 120 to 200            # machine, disk and extra RAM
life = 3 to 6                    # years
homelab = power + hardware / life

vps = (8 to 25) * 12             # comparable VPS, monthly price

homelab
vps
saving = vps - homelab
saving
