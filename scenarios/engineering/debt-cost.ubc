# Question: what does living with a piece of technical debt cost a year (hours
# lost a week × people × cost per hour), compared with fixing it, and how
# likely is the fix to pay for itself within a year?
#
# Run it (it uses the shared formulas):
#   ubc --scenario engineering/debt-cost
# Change an assumption, for example a fix that takes much longer:
#   ubc --set 'fix_weeks = 20 to 40' --scenario engineering/debt-cost
# See which assumption matters most:
#   ubc --sens yearly_cost --scenario engineering/debt-cost
#
# Every "a to b" is a 90% confidence interval. Amounts are in euros. A fix
# rarely gives back every lost hour, so only the recovered share counts
# towards paying for it.
#
# Sources: Martin Fowler, "Technical Debt" bliki
# (martinfowler.com/bliki/TechnicalDebt.html), for the interest metaphor; the
# ranges are typical experience and rules of thumb.

# Assumptions
people = 5 to 12                  # engineers who work on the affected code; count them
hours_lost = 1 to 4               # hours each loses a week to workarounds, slow changes, bugs; typical experience
weeks_per_year = 44               # working weeks, minus holidays; rule of thumb
hourly_salary = 30 to 60          # gross salary per hour (yearly salary / ~1700 hours); use your own payroll
overhead = 1.25 to 1.4            # taxes, benefits and equipment on top of the salary; rule of thumb: 25-40%
fix_weeks = 4 to 16               # engineer-weeks to fix it; ask the people who know the code
hours_per_week = 40               # working hours in an engineer-week; a usual full-time week
recovered = 60% to 90%            # share of the lost hours the fix gives back; typical experience

# Calculation
hour_cost = loaded_cost(hourly_salary, overhead)                 # what an hour of a person costs the company
yearly_cost = people * hours_lost * weeks_per_year * hour_cost    # the cost of not fixing it, every year
fix_cost = fix_weeks * hours_per_week * hour_cost                 # the cost of fixing it once
yearly_saving = yearly_cost * recovered                           # what the fix gives back every year

# Result
yearly_cost
fix_cost
P(fix_cost < yearly_saving)       # how likely is the fix to pay for itself within a year?

# Output (seed 1, 5000 samples):
#   yearly_cost = ≈ 38.1k   90% [15.7k … 91.9k]   98% [10k … 140k]   ▄▇█▇▆▄▄▃▂▂▂▂▁▁▁▁
#   fix_cost = ≈ 18k   90% [8100 … 38.6k]   98% [6000 … 52k]   ▄▆██▇▆▅▄▃▃▂▂▂▁▁▁
#   P(fix_cost < yearly_saving) = 0.75
