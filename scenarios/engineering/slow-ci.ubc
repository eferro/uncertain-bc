# Question: what does a slow CI pipeline cost a year (minutes waiting ×
# builds a day × people × cost per hour), and how likely is it to cost more
# than 100k euros?
#
# Run it (it uses the shared formulas):
#   ubc --scenario engineering/slow-ci
# Change an assumption, for example a pipeline sped up to five to eight minutes:
#   ubc --set 'minutes_waiting = 5 to 8' --scenario engineering/slow-ci
# See which assumption matters most:
#   ubc --sens yearly_cost --scenario engineering/slow-ci
#
# Every "a to b" is a 90% confidence interval. Amounts are in euros. Not all
# the waiting is lost: people switch to something else, so only the idle
# share counts, and switching has a cost of its own that is left out here.
#
# Sources: Gloria Mark et al., "The Cost of Interrupted Work: More Speed and
# Stress" (CHI 2008), for why switching away while waiting has a cost; the
# ranges are typical experience and rules of thumb.

# Assumptions
people = 10 to 20                 # engineers who push code; count them
builds_per_day = 3 to 8           # pipeline runs each of them waits for a day; look at your CI
minutes_waiting = 10 to 25        # how long a run takes, from push to result; look at your CI
idle_share = 30% to 70%           # share of the wait that is really lost; typical experience
days_per_year = 220               # working days; rule of thumb
hourly_salary = 30 to 60          # gross salary per hour (yearly salary / ~1700 hours); use your own payroll
overhead = 1.25 to 1.4            # taxes, benefits and equipment on top of the salary; rule of thumb: 25-40%

# Calculation
hour_cost = loaded_cost(hourly_salary, overhead)                                     # what an hour of a person costs the company
hours_lost = people * builds_per_day * minutes_waiting * idle_share * days_per_year / 60   # person-hours lost waiting in a year
yearly_cost = hours_lost * hour_cost                                                 # what those hours cost

# Result
hours_lost
yearly_cost
P(yearly_cost > 100k)             # how likely is the slow pipeline to cost more than 100k euros a year?

# Output (seed 1, 5000 samples):
#   hours_lost = ≈ 1850   90% [774 … 4450]   98% [520 … 6300]   ▄▇█▇▆▅▄▃▂▂▂▂▁▁▁▁
#   yearly_cost = ≈ 103k   90% [39.9k … 264k]   98% [26k … 370k]   ▄▇█▇▆▅▄▃▂▂▂▂▁▁▁▁
#   P(yearly_cost > 100k) = 0.52
