# Question: what will a migration (to a new framework, language or cloud)
# cost, and how likely is it to exceed the approved budget?
#
# Run it (it uses the shared formulas):
#   ubc --scenario engineering/migration
# Change an assumption, for example migrating only the core services:
#   ubc --set 'services = 10 to 15' --scenario engineering/migration
# See which assumption matters most:
#   ubc --sens cost --scenario engineering/migration
#
# Every "a to b" is a 90% confidence interval. Amounts are in euros.
# Migrations overrun mostly through the work nobody listed, so it gets its
# own assumption, as in the tutorial's project estimate.
#
# Sources: typical experience in software migrations; there is no published
# benchmark for these ranges, so replace them with your own numbers. The
# overhead on salaries is a rule of thumb.

# Assumptions
services = 15 to 30               # services or components to migrate; count them
weeks_per_service = 1 to 4        # engineer-weeks each, the first few longer; typical experience
forgotten = 20% to 60%            # unlisted work on top (integrations, data, tooling, docs); typical experience
weekly_salary = 1k to 1.8k        # gross salary of an engineer-week; use your own payroll
overhead = 1.25 to 1.4            # taxes, benefits and equipment on top of the salary; rule of thumb: 25-40%
parallel_months = 2 to 6          # months running old and new side by side; typical experience
parallel_monthly_cost = 5k to 20k # extra infrastructure and licences a month; look at your current bill
budget = 150k                     # what was approved; your own number

# Calculation
engineer_weeks = services * weeks_per_service * (1 + forgotten)          # the work, forgotten part included
people_cost = engineer_weeks * loaded_cost(weekly_salary, overhead)      # what that work costs the company
cost = people_cost + parallel_months * parallel_monthly_cost             # plus running both systems for a while

# Result
engineer_weeks
cost
P(cost > budget)                  # how likely is the migration to exceed the budget?

# Output (seed 1, 5000 samples):
#   engineer_weeks = ≈ 57.2   90% [26.7 … 126]   98% [19 … 180]   ▄▇█▇▇▅▄▄▃▂▂▂▁▁▁▁
#   cost = ≈ 144k   90% [74.6k … 280k]   98% [57k … 360k]   ▃▆▇██▇▅▄▃▃▃▂▂▂▁▁
#   P(cost > budget) = 0.46
