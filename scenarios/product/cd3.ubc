# Question: with three features competing for the same team, which one should
# go first by CD3 (cost of delay divided by duration), and how likely is the
# small export feature to be the right first pick?
#
# Run it (it uses the shared formulas):
#   ubc --scenario product/cd3
# Change an assumption, for example a search feature that turns out smaller:
#   ubc --set 'weeks_search = 2 to 3' --scenario product/cd3
# See which assumption matters most:
#   ubc --sens cd3_export --scenario product/cd3
#
# Every "a to b" is a 90% confidence interval. Costs of delay are in euros a
# week, durations in weeks. CD3 (Reinertsen; Joshua Arnold) does first the
# work that loses the most value per week the team spends on it, so a small
# feature with a modest cost of delay can beat a big valuable one.
#
# Sources: Don Reinertsen, The Principles of Product Development Flow (2009),
# and Joshua Arnold, Black Swan Farming (blackswanfarming.com), for CD3; the
# ranges are typical experience.

# Assumptions
cod_search = 5k to 15k            # better search: weekly value lost while it is missing; typical experience
weeks_search = 4 to 8             # weeks the team needs to build it; your team's estimate
cod_export = 2k to 6k             # export to spreadsheets, asked for by many customers; typical experience
weeks_export = 1 to 3             # weeks to build the export; your team's estimate
cod_billing = 8k to 30k           # usage-based billing: big value, big job; typical experience
weeks_billing = 8 to 20           # weeks to build the billing; your team's estimate

# Calculation
cd3_search = cd3(cod_search, weeks_search)        # value lost per week of work, search
cd3_export = cd3(cod_export, weeks_export)        # the same for the export
cd3_billing = cd3(cod_billing, weeks_billing)     # the same for billing

# Result
cd3_search
cd3_export
cd3_billing
P(cd3_export > max(cd3_search, cd3_billing))      # how likely is the export to be the right first pick?

# Output (seed 1, 5000 samples):
#   cd3_search = ≈ 1520   90% [807 … 2870]   98% [610 … 3900]   ▃▅▇██▆▅▄▃▃▂▂▁▁▁▁
#   cd3_export = ≈ 2010   90% [929 … 4350]   98% [670 … 6200]   ▄▇██▇▅▄▃▃▂▂▂▁▁▁▁
#   cd3_billing = ≈ 1200   90% [533 … 2680]   98% [390 … 3800]   ▄▆█▇▆▅▄▄▃▂▂▂▁▁▁▁
#   L38: 0.58
