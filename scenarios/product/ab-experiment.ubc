# Question: is an A/B experiment whose winning variant would likely lift
# revenue by 1-3% worth running, knowing that most variants do not win, and
# how likely is it to pay back what it costs?
#
# Run it:
#   ubc --scenario product/ab-experiment
# Change an assumption, for example a flow with less revenue behind it:
#   ubc --set 'monthly_revenue = 50k to 100k' --scenario product/ab-experiment
# See which assumption matters most:
#   ubc --sens net --scenario product/ab-experiment
#
# Every "a to b" is a 90% confidence interval. Amounts are in euros. Large
# experimentation programs report that only a minority of experiments win, so
# the expected gain is the uplift times the chance of winning.
#
# Sources: Ron Kohavi, Diane Tang and Ya Xu, Trustworthy Online Controlled
# Experiments (2020), for the low share of experiments that win; the other
# ranges are typical experience.

# Assumptions
monthly_revenue = 200k to 400k    # monthly revenue through the flow the experiment changes; read it from your analytics
uplift = 1% to 3%                 # revenue uplift if the variant wins; typical experience for a single change
win_chance = 15% to 40%           # chance the variant really wins; only a minority do (Kohavi, Tang and Xu)
months = 12                       # how long the gain lasts before the next redesign; typical experience
cost = 10k to 30k                 # design, engineering, analysis and weeks of traffic; typical experience

# Calculation
gain = monthly_revenue * uplift * months * win_chance   # expected extra revenue
net = gain - cost                                       # what is left once the experiment is paid

# Result
gain
net
P(net > 0)                        # how likely is the experiment to pay back what it costs?
