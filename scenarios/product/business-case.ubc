# Question: does a new feature pay for itself in two years, counting the users
# it reaches, how many adopt it and pay for it, and what it costs to build and
# run, and how likely is it to make money?
#
# Run it:
#   ubc --scenario product/business-case
# Change an assumption, for example a feature that converts better:
#   ubc --set 'conversion = 5% to 15%' --scenario product/business-case
# See which assumption matters most:
#   ubc --sens net --scenario product/business-case
#
# Every "a to b" is a 90% confidence interval. Amounts are in euros. Each
# factor is a funnel step: being honest about each one beats one big guess.
#
# Sources: Douglas Hubbard, How to Measure Anything (2007), for breaking the
# estimate into factors; loaded cost is salary plus 25-40% overheads (rule of
# thumb); the other ranges are typical experience, so replace them with your
# own numbers.

# Assumptions
reach = 20k to 60k                # users who see the feature in a year; read it from your analytics
adoption = 10% to 30%             # share of them who try it; typical experience for a new feature
conversion = 3% to 10%            # share of those who pay more because of it (upgrade, add-on); typical experience
arpu = 150 to 400                 # extra yearly revenue from each paying user; from your price list
build = 50k to 120k               # engineers × weeks × loaded cost (salary plus 25-40%, rule of thumb)
run = 10k to 30k                  # hosting, support and maintenance a year; typical experience
years = 2                         # horizon of the business case; a common planning choice

# Calculation
yearly_revenue = reach * adoption * conversion * arpu    # the funnel, step by step
net = (yearly_revenue - run) * years - build             # what is left after building and running it

# Result
yearly_revenue
net
P(net > 0)                        # how likely is the feature to make money in two years?
