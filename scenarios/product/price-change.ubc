# Question: if we raise the price, does the extra revenue from the customers
# who stay make up for the ones we lose, and how likely is the change to
# increase revenue?
#
# Run it:
#   ubc --scenario product/price-change
# Change an assumption, for example a bigger increase that drives more away:
#   ubc --set 'increase = 30%' --set 'lost = 10% to 30%' --scenario product/price-change
# See which assumption matters most:
#   ubc --sens gain --scenario product/price-change
#
# Every "a to b" is a 90% confidence interval. Amounts are in euros a year.
# The change pays off while the share lost stays under increase / (1 +
# increase): about 13% for a 15% increase.
#
# Sources: typical experience in software products; there is no published
# benchmark for these ranges, so replace them with your own numbers.

# Assumptions
customers = 800 to 1.2k           # paying customers today; read it from your billing
price = 50                        # monthly price today; from your price list
increase = 15%                    # the proposed increase; your decision
lost = 3% to 12%                  # share of customers who leave because of it; ask the ones who complained last time

# Calculation
before = customers * price * 12                                  # yearly revenue today
after = before * (1 - lost) * (1 + increase)                     # fewer customers paying more
gain = after - before                                            # what the change adds a year
breakeven = increase / (1 + increase)                            # the share we can lose before it stops paying

# Result
gain
breakeven
P(gain > 0)                       # how likely is the price change to increase revenue?

# Output (seed 1, 5000 samples):
#   gain = ≈ 47k   90% [7730 … 72.2k]   98% [-19k … 83k]   ▁▁▁▂▂▃▃▄▅▇██▇▅▃▂
#   breakeven = 0.1304347826
#   P(gain > 0) = 0.97
