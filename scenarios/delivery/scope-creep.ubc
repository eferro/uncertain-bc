# Question: if the scope grows while we build it, how much later do we finish
# than the plan says, and how likely are we to miss the date?
#
# Run it:
#   ubc --scenario delivery/scope-creep
# Change an assumption, for example scope that is kept under control:
#   ubc --set 'growth = 5% to 15%' --scenario delivery/scope-creep
# See which assumption matters most:
#   ubc --sens weeks --scenario delivery/scope-creep
#
# Every "a to b" is a 90% confidence interval.
#
# Sources: Capers Jones, Applied Software Measurement, for requirements creep
# of roughly 1-2% a month on software projects; the other ranges are typical
# experience.

# Assumptions
initial_scope = 80 to 120         # items in the plan when we commit to the date; count them in your tracker
growth = 10% to 60%               # scope added before the end; typical experience, Capers Jones reports ~1-2% a month
throughput = 8 to 12              # items finished a week; take it from your tracker
deadline = 12                     # weeks until the committed date; your plan

# Calculation
scope = initial_scope * (1 + growth)       # items we will really build
planned_weeks = initial_scope / throughput # what the plan says
weeks = scope / throughput                 # what it will take
weeks_late = weeks - planned_weeks         # the delay the growth alone adds

# Result
planned_weeks
weeks
weeks_late
P(weeks > deadline)               # how likely are we to miss the date?

# Output (seed 1, 5000 samples):
#   planned_weeks = ≈ 9.96   90% [7.51 … 13.3]   98% [6.5 … 15.1]   ▂▃▄▆▇█▇▇▆▅▄▃▂▂▂▁
#   weeks = ≈ 12.7   90% [9.07 … 18]   98% [7.9 … 22]   ▂▄▆▇██▇▆▅▄▃▂▂▂▁▁
#   weeks_late = ≈ 2.42   90% [0.954 … 6.11]   98% [0.66 … 9.2]   ▅██▇▆▅▃▃▂▂▂▁▁▁▁▁
#   P(weeks > deadline) = 0.60
