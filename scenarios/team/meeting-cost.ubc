# Question: how much does a recurring weekly meeting cost in a year, counting
# the time to refocus afterwards, and how likely is it to cost more than 30k
# euros?
#
# Run it (it uses the shared formulas):
#   ubc --scenario team/meeting-cost
# Change an assumption, for example inviting only the people who must decide:
#   ubc --set 'attendees = 4' --scenario team/meeting-cost
# See which assumption matters most:
#   ubc --sens yearly_cost --scenario team/meeting-cost
#
# Every "a to b" is a 90% confidence interval. Amounts are in euros.
#
# Sources: Gloria Mark et al., "The Cost of Interrupted Work: More Speed and
# Stress" (CHI 2008), for the time it takes to resume work after an
# interruption; the other ranges are typical experience and rules of thumb.

# Assumptions
attendees = 8                     # people invited who attend; your calendar
minutes = 45 to 75                # how long it really lasts, overruns included; your calendar
refocus_minutes = 10 to 25        # time lost around it to switch context, per person; see Gloria Mark et al. (CHI 2008)
meetings_per_year = 46            # weekly, minus holidays; your calendar
hourly_salary = 30 to 60          # gross salary per hour (yearly salary / ~1700 hours, rule of thumb); your payroll
overhead = 1.25 to 1.4            # taxes, benefits and equipment on top of salary; rule of thumb 25-40%

# Calculation
hour_cost = loaded_cost(hourly_salary, overhead)                # what an hour of a person costs the company
hours_per_meeting = attendees * (minutes + refocus_minutes) / 60 # person-hours one meeting takes
yearly_hours = hours_per_meeting * meetings_per_year            # person-hours in a year
yearly_cost = yearly_hours * hour_cost                          # what those hours cost

# Result
yearly_hours
yearly_cost
P(yearly_cost > 30k)              # how likely is the meeting to cost more than 30k euros a year?

# Output (seed 1, 5000 samples):
#   yearly_hours = ≈ 457   90% [366 … 566]   98% [330 … 630]   ▂▃▄▅▆▇██▇▅▄▄▃▂▂▁
#   yearly_cost = ≈ 25.7k   90% [16.9k … 38.8k]   98% [14k … 48k]   ▂▄▆███▇▆▅▄▃▂▂▂▁▁
#   P(yearly_cost > 30k) = 0.27
