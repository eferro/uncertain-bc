# Question: how many person-days of planned work can a team really deliver in
# a quarter, once holidays, sick leave, on-call and everyday interruptions are
# taken out, and how likely is it to fall short of what the roadmap needs?
#
# Run it (it uses the shared formulas):
#   ubc --scenario team/team-capacity
# Change an assumption, for example a team that protects its focus time:
#   ubc --set 'focus = 0.6 to 0.9' --scenario team/team-capacity
# See which assumption matters most:
#   ubc --sens capacity --scenario team/team-capacity
#
# Every "a to b" is a 90% confidence interval. Days are working days per
# person in one quarter.
#
# Sources: typical experience in software teams; there is no published
# benchmark for these ranges, so replace them with your own numbers.

# Assumptions
people = 6                        # engineers in the team; your own team
working_days = 63                 # weekdays in a quarter (65) minus public holidays; your local calendar
holidays = 4 to 9                 # vacation days per person in the quarter; your contracts (22-30 a year in Europe)
sick_days = 1 to 4                # sick leave per person in the quarter; your HR data or typical experience
on_call_days = 2 to 8             # days per person lost to on-call or support; your rotation schedule
focus = 0.5 to 0.8                # share of remaining time for planned work; typical experience, check your tracker
planned = 180                     # person-days of work the roadmap needs this quarter; your roadmap estimate

# Calculation
available_days = working_days - holidays - sick_days - on_call_days   # days each person is at work and not on call
capacity = real_capacity(people, available_days, focus)              # person-days left for planned work

# Result
capacity
P(capacity < planned)             # how likely is the team to fall short of the roadmap this quarter?

# Output (seed 1, 5000 samples):
#   capacity = ≈ 191   90% [148 … 246]   98% [130 … 280]   ▂▃▄▅▆███▆▆▄▃▃▂▂▁
#   P(capacity < planned) = 0.35
