# Question: how much work does onboarding a new engineer cost, counting both
# the new hire's ramp-up and the time the team spends helping them, and how
# likely is it to cost more than three full months of an engineer?
#
# Run it:
#   ubc --scenario team/onboarding
# Change an assumption, for example a well-documented codebase:
#   ubc --set 'ramp_up_months = 2 to 4' --scenario team/onboarding
# See which assumption matters most:
#   ubc --sens lost_months --scenario team/onboarding
#
# Every "a to b" is a 90% confidence interval. Work is in person-months,
# amounts in euros.
#
# Sources: Frederick Brooks, The Mythical Man-Month (1975), for the time the
# team loses bringing a new person up to speed; the ranges are typical
# experience.

# Assumptions
ramp_up_months = 3 to 9           # until fully productive; typical experience, longer in big or legacy codebases
ramp_up_gap = 0.3 to 0.6          # average share of a month's work the new hire misses meanwhile; typical experience
team_help = 0.15 to 0.5           # share of a teammate's time spent helping; typical experience, see Brooks (1975)
value_per_month = 6k to 15k       # value one engineer delivers a month; at least their loaded cost (rule of thumb)

# Calculation
new_hire_loss = ramp_up_months * ramp_up_gap    # person-months the new hire does not deliver yet
team_drag = ramp_up_months * team_help          # person-months the team spends on the new hire instead of its work
lost_months = new_hire_loss + team_drag         # all the work onboarding takes
cost = lost_months * value_per_month            # what that work is worth

# Result
lost_months
cost
P(lost_months > 3)                # how likely is onboarding to cost more than three months of a full engineer?
