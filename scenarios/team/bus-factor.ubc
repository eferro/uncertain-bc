# Question: what does it cost a year to depend on the only person who knows a
# critical system, and how likely is that risk to be worth more than two weeks
# spent spreading the knowledge (pairing, documentation, rotations)?
#
# Run it (it uses the shared formulas):
#   ubc --scenario team/bus-factor
# Change an assumption, for example a system that is easy to pick up:
#   ubc --set 'recovery_months = 1 to 2' --scenario team/bus-factor
# See which assumption matters most:
#   ubc --sens yearly_risk --scenario team/bus-factor
#
# Every "a to b" is a 90% confidence interval. Amounts are in euros.
#
# Sources: Douglas Hubbard, How to Measure Anything (2007), for the annual
# loss expectancy style of the risk; the ranges are typical experience.

# Assumptions
leave_rate = 0.08 to 0.2          # chance they leave within a year; typical attrition in tech, check your HR data
recovery_months = 2 to 6          # until someone else masters the system; typical experience
people_recovering = 1 to 2        # engineers working on it during that time; typical experience
value_per_month = 6k to 15k       # value one engineer delivers a month; at least their loaded cost (rule of thumb)
incident_chance = 0.1 to 0.5      # chance of an outage or stuck delivery meanwhile; your incident history
incident_cost = 5k to 100k        # what such an incident costs; your incident history or typical experience
cross_training = 5k               # two weeks of one engineer spreading the knowledge; loaded cost rule of thumb

# Calculation
recovery = recovery_months * people_recovering * value_per_month   # work spent learning the system again
impact = recovery + incident_chance * incident_cost                # what the person leaving costs
yearly_risk = annual_loss(leave_rate, impact)                      # expected loss per year

# Result
impact
yearly_risk
P(yearly_risk > cross_training)   # how likely is the risk to be worth more than spreading the knowledge?

# Output (seed 1, 5000 samples):
#   impact = ≈ 54.7k   90% [25.9k … 116k]   98% [18k … 160k]   ▃▆██▇▆▅▄▃▂▂▂▂▁▁▁
#   yearly_risk = ≈ 6970   90% [2880 … 16.7k]   98% [2000 … 24k]   ▄▇█▇▆▅▄▃▂▂▂▂▁▁▁▁
#   L34: 0.73
