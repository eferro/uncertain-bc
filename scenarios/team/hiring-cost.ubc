# Question: how long does it take to fill an open engineering position, how
# many hours does the whole hiring process take, and how likely is the seat to
# stay empty for more than three months?
#
# Run it:
#   ubc --scenario team/hiring-cost
# Change an assumption, for example candidates with a short notice period:
#   ubc --set 'notice_weeks = 2 to 4' --scenario team/hiring-cost
# See which assumption matters most:
#   ubc --sens time_to_fill --scenario team/hiring-cost
#
# Every "a to b" is a 90% confidence interval. Times are in weeks, amounts in
# euros.
#
# Sources: SHRM (Society for Human Resource Management) Talent Acquisition
# Benchmarking publishes time to fill and cost per hire; the ranges here are
# typical experience, so check them against your own hiring data.

# Assumptions
sourcing_weeks = 2 to 6           # from opening the position until enough good candidates apply; your hiring data
interview_weeks = 2 to 5          # interview rounds, scheduling, debriefs and the offer; your hiring data
notice_weeks = 2 to 12            # the new hire's notice period; typical: 2 weeks in the US, up to 3 months in Europe
cvs_screened = 20 to 80           # applications read before the shortlist; your applicant tracker
minutes_per_cv = 5 to 15          # time to read one application and decide; typical experience
candidates = 6 to 15              # interviewed until an offer is accepted; typical experience, check your funnel
hours_per_candidate = 3 to 8      # interviewer hours per candidate, rounds and debriefs; typical experience
coordination_hours = 15 to 40     # recruiter and manager time: ad, scheduling, offer; typical experience
hour_cost = 50 to 90              # loaded cost of an hour; rule of thumb: salary plus 25-40% overheads

# Calculation
time_to_fill = sourcing_weeks + interview_weeks + notice_weeks          # weeks until the new hire starts
screening = cvs_screened * minutes_per_cv / 60                          # hours spent reading applications
interviewing = candidates * hours_per_candidate                         # hours spent interviewing
process_hours = screening + interviewing + coordination_hours           # every hour the process takes
process_cost = process_hours * hour_cost                                # what those hours cost

# Result
time_to_fill
process_hours
process_cost
P(time_to_fill > 13)              # how likely is the seat to stay empty for more than three months (13 weeks)?
