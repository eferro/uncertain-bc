# Question: how much does it cost to replace an engineer who leaves the team,
# and how likely is it to cost more than 50k euros?
#
# Run it:
#   ubc --scenario team/replace-a-person
# Change an assumption, for example a faster hiring process:
#   ubc --set 'vacancy_months = 1 to 3' --scenario team/replace-a-person
# See which assumption matters most:
#   ubc --sens total --scenario team/replace-a-person
#
# Every "a to b" is a 90% confidence interval. Amounts are in euros.
#
# Sources: SHRM (Society for Human Resource Management) Talent Acquisition
# Benchmarking for cost per hire and time to fill; rules of thumb for agency
# fees (15-25% of the first-year salary) and the loaded cost; the rest is
# typical experience.

# Assumptions
candidates = 6 to 15              # interviewed until an offer is accepted; typical experience, check your funnel
hours_per_candidate = 3 to 8      # interviewer hours per candidate, rounds and debriefs; typical experience
interviewer_cost = 50 to 90       # loaded cost of an engineer's hour; rule of thumb: salary plus 25-40% overheads
hiring_fees = 3k to 20k           # job ads at the low end, an agency at the high end; rule of thumb 15-25% of salary
vacancy_months = 2 to 5           # notice period plus hiring, until the new hire starts; your hiring data
value_per_month = 6k to 15k       # value one engineer delivers a month; at least their loaded cost (rule of thumb)
ramp_up_months = 3 to 6           # until the new hire is fully productive; typical experience
ramp_up_gap = 0.3 to 0.6          # average share of a month's value missing while ramping up; typical experience

# Calculation
interviewing = candidates * hours_per_candidate * interviewer_cost   # team time spent interviewing
vacancy = vacancy_months * value_per_month                           # value lost while the seat is empty
ramp_up = ramp_up_months * ramp_up_gap * value_per_month             # value lost while the new hire learns
total = interviewing + hiring_fees + vacancy + ramp_up

# Result
total
P(total > 50k)                    # how likely is it to cost more than 50k euros?

# Output (seed 1, 5000 samples):
#   total = ≈ 61.1k   90% [37.8k … 100k]   98% [30k … 122k]   ▃▅▆██▇▇▆▅▄▃▂▂▂▁▁
#   P(total > 50k) = 0.75
