# Question: what will the per-seat SaaS tools cost a month in two years if
# the team keeps growing, and how likely is the bill to exceed 20k dollars a
# month by then?
#
# Run it (it uses the shared formulas):
#   ubc --scenario cloud/saas-seats
# Change an assumption, for example a hiring freeze:
#   ubc --set 'growth = 0.2% to 1%' --scenario cloud/saas-seats
# See which assumption matters most:
#   ubc --sens bill_later --scenario cloud/saas-seats
#
# Every "a to b" is a 90% confidence interval. Amounts are in dollars. Seats
# are bought for everyone, and some are never given back: people who left,
# annual true-ups, tools bought for a team that moved on.
#
# Sources: public price lists of the SaaS vendors, for per-seat prices; the
# growth and unused seats are typical experience.

# Assumptions
team = 40                         # people today; count them
growth = 1% to 4%                 # how much the team grows every month; from your hiring plan
per_seat = 150 to 300             # monthly SaaS tools per person (chat, docs, design, IDE); your vendors' price lists
unused = 10% to 25%               # seats paid for on top of the people using them; typical experience, audit yours
months = 24                       # horizon

# Calculation
team_later = compound(team, growth, months)               # people at the end of the horizon
bill_later = team_later * (1 + unused) * per_seat         # the monthly bill then, unused seats included

# Result
team_later
bill_later
P(bill_later > 20k)               # how likely are the seats to cost more than 20k dollars a month in two years?

# Output (seed 1, 5000 samples):
#   team_later = ≈ 64.4   90% [50.8 … 101]   98% [47 … 139]   ▅██▆▄▄▃▂▂▂▁▁▁▁▁▁
#   bill_later = ≈ 16.2k   90% [10.4k … 27.6k]   98% [8700 … 39k]   ▃▆██▇▆▄▃▃▂▂▂▁▁▁▁
#   P(bill_later > 20k) = 0.24
