exec ubc scenarios/engineering/automation.ubc
stdout '^hours_saved = ≈ 65\.3 '
stdout '^hours_spent = ≈ 73\.8 '
stdout '^P\(net_hours > 0\) = 0\.43\n\z'
! stderr .
exec ubc --set 'runs_per_week = 1 to 2' scenarios/engineering/automation.ubc
stdout '^P\(net_hours > 0\) = 0\.03\n\z'
exec ubc --sens net_hours scenarios/engineering/automation.ubc
stdout '^sensitivity of net_hours \(rank correlation\):\n'
stdout '^  minutes_saved +\+0\.\d\d '
