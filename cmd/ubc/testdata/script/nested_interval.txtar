exec ubc -e '(8 to 25) * 12'
stdout '^≈ 170   90% \[96 … 296\]   98% \[80 … 380\]   [▁▂▃▄▅▆▇█]{16}\n$'

exec ubc -e '1000 to 1010'
stdout '^≈ 1010   90% \[1000 … 1010\]   98% \[998 … 1012\]   '

exec ubc --interval 98 -e '(8 to 25) * 12'
stdout '^≈ 170   98% \[75\.5 … 378\]   [▁▂▃▄▅▆▇█]{16}\n$'

exec ubc --json -e '10 to 20'
stdout '"p1":[0-9.]+,"p5":[0-9.]+,"p95":[0-9.]+,"p99":[0-9.]+'
