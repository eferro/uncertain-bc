exec ubc scenarios/reliability/capacity.ubc
stdout '^next_peak = ≈ 6020 '
stdout '^nodes = ≈ 18 '
stdout '^p\(nodes, 0\.95\) = 29\n'
stdout '^P\(nodes > current_nodes\) = 0\.35\n\z'
! stderr .
exec ubc --set 'rps_per_node = 600 to 900' scenarios/reliability/capacity.ubc
stdout '^P\(nodes > current_nodes\) = 0\.06\n\z'
exec ubc --sens nodes scenarios/reliability/capacity.ubc
stdout '^sensitivity of nodes \(rank correlation\):\n'
stdout '^  rps_per_node +-0\.\d\d '
