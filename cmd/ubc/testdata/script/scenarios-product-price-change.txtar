exec ubc scenarios/product/price-change.ubc
stdout '^gain = ≈ 47k '
stdout '^breakeven = 0\.1304347826\n'
stdout '^P\(gain > 0\) = 0\.97\n\z'
! stderr .
exec ubc --set 'increase = 30%' --set 'lost = 10% to 30%' scenarios/product/price-change.ubc
stdout '^P\(gain > 0\) = 0\.81\n\z'
exec ubc --sens gain scenarios/product/price-change.ubc
stdout '^sensitivity of gain \(rank correlation\):\n'
stdout '^  lost +-0\.\d\d '
