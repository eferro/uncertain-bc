exec ubc --scenario risk/data-breach
stdout '^fine = ≈ 203k '
stdout '^breach_cost = ≈ 4\.86M '
stdout '^yearly_loss = ≈ 483k '
stdout '^P\(breach_cost > 5M\) = 0\.49\n\z'
! stderr .
exec ubc --set 'records = 1k to 20k' --scenario risk/data-breach
stdout '^P\(breach_cost > 5M\) = 0\.01\n\z'
exec ubc --sens breach_cost --scenario risk/data-breach
stdout '^sensitivity of breach_cost \(rank correlation\):\n'
stdout '^  records +\+0\.\d\d '
