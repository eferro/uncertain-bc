exec ubc scenarios/formulas.ubc scenarios/risk/data-breach.ubc
stdout '^L33: ≈ 203k '
stdout '^L34: ≈ 4\.86M '
stdout '^L35: ≈ 483k '
stdout '^L36: 0\.49\n\z'
! stderr .
exec ubc --set 'records = 1k to 20k' scenarios/formulas.ubc scenarios/risk/data-breach.ubc
stdout '^L36: 0\.01\n\z'
exec ubc --sens breach_cost scenarios/formulas.ubc scenarios/risk/data-breach.ubc
stdout '^sensitivity of breach_cost \(rank correlation\):\n'
stdout '^  records +\+0\.\d\d '
