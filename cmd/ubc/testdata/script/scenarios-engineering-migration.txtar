exec ubc scenarios/formulas.ubc scenarios/engineering/migration.ubc
stdout '^engineer_weeks = ≈ 57\.2 '
stdout '^cost = ≈ 144k '
stdout '^P\(cost > budget\) = 0\.46\n\z'
! stderr .
exec ubc --set 'services = 10 to 15' scenarios/formulas.ubc scenarios/engineering/migration.ubc
stdout '^P\(cost > budget\) = 0\.14\n\z'
exec ubc --sens cost scenarios/formulas.ubc scenarios/engineering/migration.ubc
stdout '^sensitivity of cost \(rank correlation\):\n'
stdout '^  weeks_per_service +\+0\.\d\d '
