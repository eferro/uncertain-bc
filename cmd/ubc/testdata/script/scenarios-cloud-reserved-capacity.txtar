exec ubc scenarios/cloud/reserved-capacity.ubc
stdout '^savings = ≈ 129k '
stdout '^P\(usage < commitment\) = 0\.53\n'
stdout '^P\(savings > 0\) = 0\.83\n\z'
! stderr .
exec ubc --set 'usage = 20k to 60k' scenarios/cloud/reserved-capacity.ubc
stdout '^P\(savings > 0\) = 0\.44\n\z'
exec ubc --sens savings scenarios/cloud/reserved-capacity.ubc
stdout '^sensitivity of savings \(rank correlation\):\n'
stdout '^  usage +\+0\.\d\d '
