exec ubc --scenario engineering/debt-cost
stdout '^yearly_cost = ≈ 38\.1k '
stdout '^fix_cost = ≈ 18k '
stdout '^P\(fix_cost < yearly_saving\) = 0\.75\n\z'
! stderr .
exec ubc --set 'fix_weeks = 20 to 40' --scenario engineering/debt-cost
stdout '^P\(fix_cost < yearly_saving\) = 0\.07\n\z'
exec ubc --sens yearly_cost --scenario engineering/debt-cost
stdout '^sensitivity of yearly_cost \(rank correlation\):\n'
stdout '^  hours_lost +\+0\.\d\d '
