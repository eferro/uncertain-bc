exec ubc --scenario reliability/availability
stdout '^nines = ≈ 2\.8 '
stdout '^downtime_minutes = ≈ 68\.6 '
stdout '^P\(availability > 99\.9%\) = 0\.14\n\z'
! stderr .
exec ubc --echo --scenario reliability/availability
stdout '^balancer = ≈ 0\.99978   90% \[0\.99951 … 0\.9999\]   98% \[0\.9993 … 0\.99993\]   '
stdout '^application = ≈ 0\.99996   90% \[0\.99961 … 1\]   '
exec ubc --set 'database_down = 0.01% to 0.05%' --scenario reliability/availability
stdout '^P\(availability > 99\.9%\) = 0\.93\n\z'
exec ubc --sens availability --scenario reliability/availability
stdout '^sensitivity of availability \(rank correlation\):\n'
stdout '^  database_down +-0\.\d\d '
