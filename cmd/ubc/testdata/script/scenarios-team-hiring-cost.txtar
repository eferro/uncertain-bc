exec ubc scenarios/team/hiring-cost.ubc
stdout '^L34: ≈ 12 '
stdout '^L35: ≈ 79\.6 '
stdout '^L36: ≈ 5330 '
stdout '^L37: 0\.38\n\z'
! stderr .
exec ubc --set 'notice_weeks = 2 to 4' scenarios/team/hiring-cost.ubc
stdout '^L37: 0\.04\n\z'
exec ubc --sens time_to_fill scenarios/team/hiring-cost.ubc
stdout '^sensitivity of time_to_fill \(rank correlation\):\n  notice_weeks +\+0\.85 '
