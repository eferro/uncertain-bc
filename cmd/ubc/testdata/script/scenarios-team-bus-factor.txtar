exec ubc scenarios/formulas.ubc scenarios/team/bus-factor.ubc
stdout '^L29: ≈ 54\.7k '
stdout '^L30: ≈ 6970 '
stdout '^L31: 0\.73\n\z'
! stderr .
exec ubc --set 'recovery_months = 1 to 2' scenarios/formulas.ubc scenarios/team/bus-factor.ubc
stdout '^L31: 0\.21\n\z'
exec ubc --sens yearly_risk scenarios/formulas.ubc scenarios/team/bus-factor.ubc
stdout '^sensitivity of yearly_risk \(rank correlation\):\n'
stdout '^  recovery_months +\+0\.\d\d '
