exec ubc -e '1k * 3'
stdout '^3000\n$'

exec ubc -e '5% * 200'
stdout '^10\n$'

exec ubc -e '10k to 50k'
cmp stdout thousands.out

exec ubc -e '11.5M to 11.7M'
cmp stdout millions.out

-- thousands.out --
≈ 22.4k   90% [9990 … 49k]   98% [7000 … 69k]   ▄▇██▇▅▄▄▃▂▂▂▁▁▁▁
-- millions.out --
≈ 11.6M   90% [11.5M … 11.7M]   98% [11.46M … 11.74M]   ▂▂▃▄▅▆▇██▇▆▅▄▃▂▂
