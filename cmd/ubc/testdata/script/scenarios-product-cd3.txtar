exec ubc scenarios/formulas.ubc scenarios/product/cd3.ubc
stdout '^L31: ≈ 1520 '
stdout '^L32: ≈ 2010 '
stdout '^L33: ≈ 1200 '
stdout '^L34: 0\.58\n\z'
! stderr .
exec ubc --set 'weeks_search = 2 to 3' scenarios/formulas.ubc scenarios/product/cd3.ubc
stdout '^L34: 0\.16\n\z'
exec ubc --sens cd3_export scenarios/formulas.ubc scenarios/product/cd3.ubc
stdout '^sensitivity of cd3_export \(rank correlation\):\n'
stdout '^  weeks_export +-0\.\d\d '
