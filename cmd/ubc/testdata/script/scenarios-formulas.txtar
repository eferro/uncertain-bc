exec ubc scenarios/formulas.ubc
! stdout .
! stderr .

exec ubc scenarios/formulas.ubc check.ubc
cmp stdout check.out
! stderr .

exec ubc scenarios/formulas.ubc uncertain.ubc
stdout '^L1: ≈ 4\.99 '
stdout '^L2: ≈ 34\.9k '
! stderr .

-- uncertain.ubc --
lead_time(15 to 30, 3 to 6)
npv(50k, 2k to 4k, 0.01, 36)
-- check.ubc --
loaded_cost(50000, 1.3)
lead_time(20, 4)
ltv(100, 0.8, 0.02)
cac_payback(1200, 100, 0.8)
annual_loss(0.1, 200000)
availability_series(0.99, 0.9)
availability_parallel(0.99, 0.9)
compound(1000, 0.1, 2)
present_value(1210, 0.1, 2)
npv(1000, 500, 0.1, 3)
delay_cost(3000, 4)
cd3(3000, 2)
real_capacity(5, 10, 0.6)
