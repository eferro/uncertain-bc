exec ubc --scenario formulas
! stdout .
! stderr .

exec ubc --scenario formulas check.ubc
cmp stdout check.out
! stderr .

exec ubc --scenario formulas constants.ubc
cmp stdout constants.out
! stderr .

exec ubc --set 'working_days_per_year = 200' --scenario formulas -e 'working_weeks_per_year'
stdout '^40\n\z'
! stderr .

exec ubc --echo --scenario formulas
stdout '^hours_per_day = 8\n'
stdout '^weeks_per_year = 52\n'
! stderr .

exec ubc --scenario formulas uncertain.ubc
stdout '^lead_time\(15 to 30, 3 to 6\) = ≈ 4\.99 '
stdout '^npv\(50k, 2k to 4k, 0\.01, 36\) = ≈ 34\.9k '
! stderr .

-- constants.ubc --
minutes_per_hour
hours_per_day
hours_per_calendar_day
days_per_week
days_per_month
working_days_per_year
working_weeks_per_year
weeks_per_year
months_per_year
-- constants.out --
minutes_per_hour = 60
hours_per_day = 8
hours_per_calendar_day = 24
days_per_week = 5
days_per_month = 30
working_days_per_year = 220
working_weeks_per_year = 44
weeks_per_year = 52
months_per_year = 12
-- uncertain.ubc --
lead_time(15 to 30, 3 to 6)
npv(50k, 2k to 4k, 0.01, 36)
-- check.ubc --
loaded_cost(50000, 1.3)
lead_time(20, 4)
ltv(100, 0.8, 0.02)
cac_payback(1200, 100, 0.8)
annual_loss(0.1, 200000)
availability_series(0.99, 0.9)
availability_parallel(0.99, 0.9)
compound(1000, 0.1, 2)
present_value(1210, 0.1, 2)
npv(1000, 500, 0.1, 3)
delay_cost(3000, 4)
cd3(3000, 2)
real_capacity(5, 10, 0.6)
-- check.out --
loaded_cost(50000, 1.3) = 65000
lead_time(20, 4) = 5
ltv(100, 0.8, 0.02) = 4000
cac_payback(1200, 100, 0.8) = 15
annual_loss(0.1, 200000) = 20000
availability_series(0.99, 0.9) = 0.891
L7: 0.999
compound(1000, 0.1, 2) = 1210
present_value(1210, 0.1, 2) = 1000
npv(1000, 500, 0.1, 3) = 243.4259955
delay_cost(3000, 4) = 12000
cd3(3000, 2) = 1500
real_capacity(5, 10, 0.6) = 30
