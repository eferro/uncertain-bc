exec ubc scenarios/formulas.ubc scenarios/product/cost-of-delay.ubc
stdout '^weekly_value = ≈ 11\.9k '
stdout '^cost = ≈ 82\.6k '
stdout '^P\(cost > 100k\) = 0\.38\n\z'
! stderr .
exec ubc --set 'delay_weeks = 2 to 4' scenarios/formulas.ubc scenarios/product/cost-of-delay.ubc
stdout '^P\(cost > 100k\) = 0\.02\n\z'
exec ubc --sens cost scenarios/formulas.ubc scenarios/product/cost-of-delay.ubc
stdout '^sensitivity of cost \(rank correlation\):\n'
stdout '^  delay_weeks +\+0\.\d\d '
