exec ubc scenarios/product/business-case.ubc
stdout '^yearly_revenue = ≈ 80\.7k '
stdout '^net = ≈ 45\.5k '
stdout '^P\(net > 0\) = 0\.68\n\z'
! stderr .
exec ubc --set 'conversion = 5% to 15%' scenarios/product/business-case.ubc
stdout '^P\(net > 0\) = 0\.87\n\z'
exec ubc --sens net scenarios/product/business-case.ubc
stdout '^sensitivity of net \(rank correlation\):\n'
stdout '^  conversion +\+0\.\d\d '
