exec ubc --scenario product/ltv-cac
stdout '^lifetime_value = ≈ 4850 '
stdout '^payback = ≈ 10\.3 '
stdout '^ratio = ≈ 4\.81 '
stdout '^P\(payback <= 12\) = 0\.62\n\z'
! stderr .
exec ubc --set 'cac = 1.5k to 4k' --scenario product/ltv-cac
stdout '^P\(payback <= 12\) = 0\.03\n\z'
exec ubc --sens payback --scenario product/ltv-cac
stdout '^sensitivity of payback \(rank correlation\):\n'
stdout '^  cac +\+0\.\d\d '
